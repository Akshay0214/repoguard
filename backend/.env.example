PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Server-side only. Do not add a VITE_OPENAI_API_KEY.
# OPENAI_MODEL must be a model that supports structured outputs (json_schema).
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional. When empty, analysis jobs stay in process memory.
MONGODB_URI=
MONGODB_DB=repoguard

# Required when AUTH_REQUIRED=true or NODE_ENV=production.
# Leave AUTH_REQUIRED unset in development to allow unauthenticated local use.
JWT_SECRET=
AUTH_REQUIRED=

# Optional server-side token for private GitHub repositories.
# Request tokens sent as X-GitHub-Token are not stored.
GITHUB_TOKEN=

# Byte limits and timeouts.
MAX_ZIP_BYTES=52428800
MAX_ZIP_UNCOMPRESSED_BYTES=209715200
REQUEST_TIMEOUT_MS=60000
CLONE_TIMEOUT_MS=180000
